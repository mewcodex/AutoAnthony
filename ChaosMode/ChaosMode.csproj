<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>AutoAnthony</AssemblyName>
    <RootNamespace>AutoAnthony</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin\$(Configuration)\net9.0\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">$(STS2_GAME_DIR)</Sts2GameDir>
    <Sts2LibDir Condition="'$(Sts2GameDir)' != ''">$(Sts2GameDir)\data_sts2_windows_x86_64</Sts2LibDir>
  </PropertyGroup>
  <Target Name="VerifyStsGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(Sts2GameDir)' == '' Or !Exists('$(Sts2LibDir)\sts2.dll')"
           Text="STS2 install not found. Set STS2_GAME_DIR or pass /p:Sts2GameDir=..." />
  </Target>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(Sts2LibDir)\sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2LibDir)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2LibDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\ChaosCardGenerator\RandomCardGenerator.cs" Link="Generator\RandomCardGenerator.cs" />
    <Compile Include="..\ChaosCardGenerator\GeneratedCardTagPolicy.cs" Link="Generator\GeneratedCardTagPolicy.cs" />
    <Compile Include="..\ChaosCardGenerator\SpecialXCardConverter.cs" Link="Generator\SpecialXCardConverter.cs" />
    <Compile Include="..\ChaosCardGenerator\SlyKeywordTuning.cs" Link="Generator\SlyKeywordTuning.cs" />
    <Compile Include="..\ChaosCardGenerator\SlyPoolConstraintResolver.cs" Link="Generator\SlyPoolConstraintResolver.cs" />
    <Compile Include="..\ChaosCardGenerator\StartingPoolConstraintResolver.cs" Link="Generator\StartingPoolConstraintResolver.cs" />
    <Compile Include="..\ChaosCardGenerator\ComponentAssemblyGenerator.cs" Link="Generator\ComponentAssemblyGenerator.cs" />
    <Compile Include="..\ChaosCardGenerator\ComponentApi.cs" Link="Generator\ComponentApi.cs" />
    <Compile Include="..\ChaosCardGenerator\ComponentPackageApi.cs" Link="Generator\ComponentPackageApi.cs" />
    <Compile Include="..\ChaosCardGenerator\ComponentValuationApi.cs" Link="Generator\ComponentValuationApi.cs" />
    <Compile Include="..\ChaosCardGenerator\CardTinkeringApi.cs" Link="Generator\CardTinkeringApi.cs" />
    <Compile Include="..\ChaosCardGenerator\NativeCardDecompositionApi.cs" Link="Generator\NativeCardDecompositionApi.cs" />
    <Compile Include="..\ChaosCardGenerator\ImmutableComponentCatalog.cs" Link="Generator\ImmutableComponentCatalog.cs" />
    <Compile Include="..\ChaosCardGenerator\ComponentPolicy.cs" Link="Generator\ComponentPolicy.cs" />
    <Compile Include="..\ChaosCardGenerator\NativeComponentFrequencyTracker.cs" Link="Generator\NativeComponentFrequencyTracker.cs" />
    <Compile Include="..\ChaosCardGenerator\GenerationTuning.cs" Link="Generator\GenerationTuning.cs" />
    <Compile Include="..\ChaosCardGenerator\EffectBalanceModel.cs" Link="Generator\EffectBalanceModel.cs" />
    <Compile Include="..\ChaosCardGenerator\ResourceEconomyModel.cs" Link="Generator\ResourceEconomyModel.cs" />
