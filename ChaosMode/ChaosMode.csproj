    <Compile Include="..\ChaosCardGenerator\CardIdentityAndUpgradeGenerator.cs" Link="Generator\CardIdentityAndUpgradeGenerator.cs" />
    <Compile Include="..\ChaosCardGenerator\NativeUpgradeValueModel.cs" Link="Generator\NativeUpgradeValueModel.cs" />
    <Compile Include="..\ChaosCardGenerator\PercentageValueTuning.cs" Link="Generator\PercentageValueTuning.cs" />
